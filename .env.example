# Kisan Vyapar Portal - Environment Variables Configuration

# ----------------------------------------------------
# 1. Site Configuration
# ----------------------------------------------------
# Replace with your Vercel deployment URL (e.g. https://your-project.vercel.app)
NEXT_PUBLIC_SITE_URL=https://kisan-vyapar-portal.vercel.app

# ----------------------------------------------------
# 2. Razorpay Payment Gateway (Optional / Test Mode)
# ----------------------------------------------------
# Get keys from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_kisan_vyapar_demo
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret

# ----------------------------------------------------
# 3. Weather Service (Optional - simulated if empty)
# ----------------------------------------------------
# Free API key from https://openweathermap.org/api
WEATHER_API_KEY=11496312840b4e85a6f64233262809

# ----------------------------------------------------
# 4. Supabase (Optional / If migrating from local database)
# ----------------------------------------------------
# Get from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------
# 5. Fast2SMS Real Mobile OTP Gateway (India)
# ----------------------------------------------------
# Sign up at https://www.fast2sms.com -> Dev API -> Copy your API Key
# Leaves demo mode and delivers real SMS to user's mobile phone number
FAST2SMS_API_KEY=your_fast2sms_api_key_here

